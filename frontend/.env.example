# Copy this file to ".env" (same folder as server.ts) and fill in your RunPod values.
# The server reads ONLY .env / .env.local – this .env.example file is never loaded.
# Restart `npm run dev` after every change.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# HAIRFASTGAN_API_URL: RunPod Serverless Load Balancer endpoint running the HairFastGAN app
#   https://[ENDPOINT_ID].api.runpod.ai   (the app must expose POST /generate and GET /ping)
HAIRFASTGAN_API_URL=https://your-endpoint-id.api.runpod.ai

# RUNPOD_API_KEY: RunPod API key (rpa_...), sent as "Authorization: Bearer <key>"
RUNPOD_API_KEY=rpa_xxxxxxxxxxxxxxxxxxxxxxxx

# HAIRFASTGAN_API_TOKEN: token checked by the HairFastGAN app itself, sent as "x-api-key".
# If you only have one key, put the same rpa_ key here – either variable alone is enough.
HAIRFASTGAN_API_TOKEN=rpa_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: max seconds to wait for one generation (default 180000 ms, covers RunPod cold start)
# HAIRFASTGAN_TIMEOUT_MS=180000
