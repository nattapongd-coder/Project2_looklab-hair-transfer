    candidates.forEach((r,i)=>{if(revision)r.image_id='IMG_'+Utilities.getUuid().replace(/-/g,'');const row=!revision&&current[i]?current[i]._row:sh.getLastRow()+1;sh.getRange(row,1,1,11).setValues([FS_SCHEMA.FS_Images.map(k=>r[k])]);});SpreadsheetApp.flush();return {ok:true,revised:revision,image_ids:candidates.map(r=>r.image_id)};
  }finally{lock.releaseLock();}}
function adminSetPairEnabled(token,participantId,pairId,imageIds,enabled){session_(token,'admin');if(typeof enabled!=='boolean'||!Array.isArray(imageIds)||imageIds.length>2||!imageIds.length)throw Error('ข้อมูลไม่ถูกต้อง');const lock=LockService.getScriptLock();lock.waitLock(15000);try{const all=rows_('FS_Images'),records=all.filter(r=>imageIds.includes(r.image_id)&&r.participant_id===participantId&&r.pair_id===pairId);if(records.length!==imageIds.length)throw Error('ชุดภาพเปลี่ยนแล้ว');if(enabled){if(records.length!==2||new Set(records.map(r=>r.model)).size!==2)throw Error('เปิดชุดที่มีสองโมเดลครบเท่านั้น');if(all.some(r=>r.participant_id===participantId&&r.pair_id===pairId&&enabled_(r)&&!imageIds.includes(r.image_id)))throw Error('ชุดนี้มีเวอร์ชันอื่นเปิดอยู่แล้ว');['original_file_id','hair_file_id','color_file_id'].forEach(k=>{if(records[0][k]!==records[1][k])throw Error('ภาพอ้างอิงทั้งสองโมเดลต้องตรงกัน')});records.forEach(r=>['original','hair','color','result'].forEach(k=>driveImage_(r[k+'_file_id'])));}records.forEach(r=>db_().getSheetByName('FS_Images').getRange(r._row,11).setValues([[enabled]]));return {ok:true};}finally{lock.releaseLock();}}
