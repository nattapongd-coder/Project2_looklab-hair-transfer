/** FORME Hair Study — container-bound Google Apps Script.
 * Install from the editor as spreadsheet owner. All privileged helpers end in _.
 * No public URLs, file names, model labels, or Drive IDs returned to participants.
 */
const FS_SCHEMA = {
  FS_Participants:['participant_id','login_hash','status'],
  FS_Codes:['participant_id','login_code'],
  FS_Images:['image_id','participant_id','pair_id','model','tuning_variant','original_file_id','hair_file_id','color_file_id','result_file_id','generation_seconds','enabled'],
  FS_Responses:['participant_id','image_id','q1','q2','q3','q4','q5','wait_bin','updated_at']
};
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('FORME • Hair Study').addMetaTag('viewport','width=device-width,initial-scale=1');}
function onOpen(){SpreadsheetApp.getUi().createMenu('FORME').addItem('ตั้งค่าชีตและสุ่มรหัส 40 คน','setupResearch_').addItem('ตรวจข้อมูลภาพก่อนเปิดใช้','validateImages_').addToUi();}
function setupResearch_(){
  const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error('เปิด Apps Script จาก Extensions ของ Google Sheets ก่อน');
  const props=PropertiesService.getScriptProperties();props.setProperty('SPREADSHEET_ID',ss.getId());
  if(!props.getProperty('AUTH_SALT'))props.setProperty('AUTH_SALT',Utilities.getUuid()+Utilities.getUuid());
  Object.keys(FS_SCHEMA).forEach(name=>{let sh=ss.getSheetByName(name)||ss.insertSheet(name);const headers=FS_SCHEMA[name];if(sh.getLastRow()===0){sh.getRange(1,1,1,headers.length).setValues([headers]);sh.setFrozenRows(1);sh.getRange(1,1,1,headers.length).setBackground('#514167').setFontColor('#ffffff');}else if(sh.getRange(1,1,1,headers.length).getValues()[0].join('|')!==headers.join('|'))throw Error('หัวตาราง '+name+' ไม่ตรง กรุณาใช้ชีตใหม่หรือแก้ header ตามคู่มือ');});
  const p=ss.getSheetByName('FS_Participants'),c=ss.getSheetByName('FS_Codes');
  if(p.getLastRow()===1){
    const used=new Set(),rows=[],codes=[];
    for(let i=1;i<=40;i++){let pin;do{pin=String(100000+randomInt_(900000));}while(used.has(pin));used.add(pin);const id='U'+String(i).padStart(3,'0');rows.push([id,hash_(pin),'active']);codes.push([id,pin]);}
    p.getRange(2,1,40,3).setValues(rows);c.getRange(2,2,40,1).setNumberFormat('@');c.getRange(2,1,40,2).setValues(codes);
  }
  if(!props.getProperty('ADMIN_LOGIN_HASH')){
    let pin;const used=new Set(c.getDataRange().getDisplayValues().slice(1).map(r=>r[1]));do{pin=String(100000000000+randomInt_(900000000000));}while(used.has(pin));
    props.setProperty('ADMIN_LOGIN_HASH',hash_(pin));const row=c.getLastRow()+1;c.getRange(row,2).setNumberFormat('@');c.getRange(row,1,1,2).setValues([['ADMIN',pin]]);
  }
  ss.toast('พร้อมแล้ว: รหัสอยู่ใน FS_Codes (เฉพาะผู้วิจัย) เพิ่มภาพใน FS_Images ต่อได้','FORME',8);
}
function randomInt_(range){const hex=Utilities.getUuid().replace(/-/g,'').slice(0,12);return parseInt(hex,16)%range;}
function props_(){return PropertiesService.getScriptProperties();}
function db_(){const id=props_().getProperty('SPREADSHEET_ID');if(!id)throw Error('ผู้วิจัยยังไม่ได้ตั้งค่าระบบ');return SpreadsheetApp.openById(id);}
function hash_(s){const salt=props_().getProperty('AUTH_SALT');if(!salt)throw Error('ยังไม่ได้ตั้งค่าระบบ');return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,salt+'|'+s,Utilities.Charset.UTF_8).map(b=>(b+256).toString(16).slice(-2)).join('');}
function rows_(name){const sh=db_().getSheetByName(name);if(!sh)throw Error('ไม่พบชีต '+name);const data=sh.getDataRange().getValues(),headers=FS_SCHEMA[name];if(data[0].slice(0,headers.length).join('|')!==headers.join('|'))throw Error('หัวตาราง '+name+' ไม่ตรง');return data.slice(1).map((r,i)=>Object.assign({_row:i+2},Object.fromEntries(headers.map((k,j)=>[k,r[j]])))).filter(r=>headers.some(k=>r[k]!==''));}
function active_(pid){const people=rows_('FS_Participants');return people.find(p=>String(p.participant_id)===pid&&p.status==='active');}
function session_(token,role){if(typeof token!=='string'||token.length>100)throw Error('กรุณาเข้าสู่ระบบใหม่');const raw=CacheService.getScriptCache().get('session:'+hash_(token));if(!raw)throw Error('เซสชันหมดอายุ กรุณาเข้าสู่ระบบใหม่');const s=JSON.parse(raw);if(s.expires<Date.now())throw Error('เซสชันหมดอายุ กรุณาเข้าสู่ระบบใหม่');if(role&&s.role!==role)throw Error('ไม่มีสิทธิ์เข้าถึง');if(s.role==='participant'){const p=active_(s.participant_id);if(!p)throw Error('รหัสนี้ถูกระงับแล้ว');if(s.auth_hash!==p.login_hash)throw Error('รหัสเข้าสู่ระบบเปลี่ยนแล้ว กรุณาเข้าสู่ระบบใหม่');}else if(s.auth_hash!==props_().getProperty('ADMIN_LOGIN_HASH'))throw Error('กรุณาเข้าสู่ระบบใหม่');return s;}
function login(code){
  if(typeof code!=='string'||!/^\d{6,12}$/.test(code))throw Error('กรุณากรอกรหัสตัวเลข 6–12 หลัก');
  const lock=LockService.getScriptLock();lock.waitLock(10000);
  try{
    const cache=CacheService.getScriptCache(),minute=Math.floor(Date.now()/60000),key='login-rate:'+minute,attempts=Number(cache.get(key)||0);
    if(attempts>=120)throw Error('มีการเข้าสู่ระบบถี่เกินไป กรุณารอสักครู่');cache.put(key,String(attempts+1),120);
    const h=hash_(code),failKey='login-fail:'+h,failures=Number(cache.get(failKey)||0);if(failures>=5)throw Error('รหัสนี้ถูกลองบ่อยเกินไป กรุณารอ 10 นาที');
    const p=rows_('FS_Participants').find(r=>r.login_hash===h&&r.status==='active');const role=h===props_().getProperty('ADMIN_LOGIN_HASH')?'admin':p?'participant':null;
    if(!role){cache.put(failKey,String(failures+1),600);throw Error('รหัสไม่ถูกต้องหรือถูกระงับ');}
    cache.remove(failKey);const token=Utilities.getUuid()+Utilities.getUuid();const result={token:token,role:role,participant_id:p?String(p.participant_id):null};
    cache.put('session:'+hash_(token),JSON.stringify({role:role,participant_id:result.participant_id,auth_hash:h,expires:Date.now()+21600000}),21600);return result;
  }finally{lock.releaseLock();}
}
function logout(token){session_(token);CacheService.getScriptCache().remove('session:'+hash_(token));return {ok:true};}
function assigned_(pid){return rows_('FS_Images').filter(r=>String(r.participant_id)===pid&&(r.enabled===true||String(r.enabled).toLowerCase()==='true'));}
function image_(pid,id){const list=assigned_(pid).filter(r=>('I'+hash_(pid+'|opaque|'+r.image_id).slice(0,24))===id);if(list.length!==1)throw Error('ภาพนี้ไม่มีสิทธิ์เข้าถึง หรือรหัสภาพซ้ำ');return list[0];}
function getParticipant(token){const s=session_(token,'participant');const images=assigned_(s.participant_id);const seen=new Set();images.forEach(r=>{if(seen.has(r.image_id))throw Error('รหัสภาพซ้ำ กรุณาติดต่อผู้วิจัย');seen.add(r.image_id)});
  images.sort((a,b)=>hash_(s.participant_id+'|'+a.image_id).localeCompare(hash_(s.participant_id+'|'+b.image_id)));
  const allowed=new Set(images.map(r=>String(r.image_id))),answers={};rows_('FS_Responses').filter(r=>String(r.participant_id)===s.participant_id&&allowed.has(String(r.image_id))).forEach(r=>{if(validResponse_(r))answers['I'+hash_(s.participant_id+'|opaque|'+r.image_id).slice(0,24)]={q1:r.q1,q2:r.q2,q3:r.q3,q4:r.q4,q5:r.q5,wait_bin:r.wait_bin};});
  return {participant_id:s.participant_id,items:images.map(r=>({image_id:'I'+hash_(s.participant_id+'|opaque|'+r.image_id).slice(0,24)})),answers:answers};
}
function getImage(token,imageId){const s=session_(token,'participant');if(typeof imageId!=='string')throw Error('รหัสภาพไม่ถูกต้อง');const r=image_(s.participant_id,imageId);return {original:driveImage_(r.original_file_id),hair:driveImage_(r.hair_file_id),color:driveImage_(r.color_file_id),result:driveImage_(r.result_file_id)};}
function driveImage_(id){if(typeof id!=='string'||!/^[\w-]{10,}$/.test(id))throw Error('ผู้วิจัยยังไม่ได้ตั้งค่าไฟล์ภาพให้ถูกต้อง');try{const blob=DriveApp.getFileById(id).getBlob();if(!/^image\/(jpeg|png|webp)$/.test(blob.getContentType()))throw Error('format');const bytes=blob.getBytes();if(bytes.length>2*1024*1024)throw Error('size');return 'data:'+blob.getContentType()+';base64,'+Utilities.base64Encode(bytes);}catch(e){throw Error('โหลดภาพไม่ได้: กรุณาให้ผู้วิจัยตรวจสิทธิ์ Drive และใช้ JPG/PNG/WebP ไม่เกิน 2 MB ต่อภาพ');}}
function validResponse_(r){return [1,2,3,4,5].every(i=>Number.isInteger(r['q'+i])&&r['q'+i]>=1&&r['q'+i]<=5)&&Number.isInteger(r.wait_bin)&&r.wait_bin>=0&&r.wait_bin<=5;}
function saveResponse(token,payload){const s=session_(token,'participant');if(!payload||typeof payload!=='object')throw Error('ข้อมูลไม่ถูกต้อง');const keys=['image_id','q1','q2','q3','q4','q5','wait_bin'];if(Object.keys(payload).some(k=>!keys.includes(k))||keys.some(k=>!(k in payload)))throw Error('รูปแบบข้อมูลไม่ถูกต้อง');if(!validResponse_(payload))throw Error('ข้อ 1–5 ต้องเป็นจำนวนเต็ม 1–5 และต้องเลือกข้อเวลา');const assignedImage=image_(s.participant_id,payload.image_id);
  const lock=LockService.getScriptLock();lock.waitLock(15000);try{
    session_(token,'participant');image_(s.participant_id,payload.image_id);
    const found=rows_('FS_Responses').filter(r=>String(r.participant_id)===s.participant_id&&String(r.image_id)===String(assignedImage.image_id));if(found.length>1)throw Error('พบข้อมูลซ้ำ กรุณาติดต่อผู้วิจัย');const sh=db_().getSheetByName('FS_Responses'),row=found.length?found[0]._row:sh.getLastRow()+1;
    sh.getRange(row,1,1,9).setValues([[s.participant_id,String(assignedImage.image_id),payload.q1,payload.q2,payload.q3,payload.q4,payload.q5,payload.wait_bin,new Date().toISOString()]]);SpreadsheetApp.flush();return {ok:true};
  }finally{lock.releaseLock();}
}
function getDashboard(token){session_(token,'admin');const people=rows_('FS_Participants').filter(p=>p.status==='active'),pids=new Set(people.map(p=>String(p.participant_id))),images=rows_('FS_Images').filter(r=>pids.has(String(r.participant_id))&&(r.enabled===true||String(r.enabled).toLowerCase()==='true')),map={};images.forEach(r=>{const key=r.participant_id+'|'+r.image_id;if(map[key])throw Error('FS_Images มีรหัสภาพซ้ำ');map[key]=r;});
  const seen=new Set(),responses=[];rows_('FS_Responses').forEach(r=>{const key=r.participant_id+'|'+r.image_id,img=map[key];if(!img||!validResponse_(r))return;if(seen.has(key))throw Error('FS_Responses มีคำตอบซ้ำ');seen.add(key);responses.push({participant_id:String(r.participant_id),image_id:String(r.image_id),pair_id:String(img.pair_id),model:String(img.model),tuning_variant:String(img.tuning_variant),q1:r.q1,q2:r.q2,q3:r.q3,q4:r.q4,q5:r.q5,wait_bin:r.wait_bin,generation_seconds:img.generation_seconds===''?null:Number(img.generation_seconds),updated_at:r.updated_at instanceof Date?r.updated_at.toISOString():String(r.updated_at)});});
  const activeKeys=new Set(responses.map(r=>r.participant_id+'|'+r.image_id)),allImages=rows_('FS_Images'),archived=[];rows_('FS_Responses').forEach(r=>{if(activeKeys.has(r.participant_id+'|'+r.image_id)||!validResponse_(r))return;const img=allImages.find(i=>i.image_id===r.image_id&&i.participant_id===r.participant_id);if(img)archived.push({participant_id:String(r.participant_id),image_id:String(r.image_id),pair_id:String(img.pair_id),model:String(img.model),tuning_variant:String(img.tuning_variant),q1:r.q1,q2:r.q2,q3:r.q3,q4:r.q4,q5:r.q5,wait_bin:r.wait_bin,generation_seconds:img.generation_seconds===''?null:Number(img.generation_seconds),updated_at:r.updated_at instanceof Date?r.updated_at.toISOString():String(r.updated_at)});});
  return {archived_responses:archived,participants:people.map(p=>({participant_id:String(p.participant_id),status:p.status,total:images.filter(r=>r.participant_id===p.participant_id).length})),responses:responses};
}
function validateImages_(){const people=rows_('FS_Participants').filter(p=>p.status==='active'),ids=new Set(),pairs={};const images=rows_('FS_Images').filter(r=>r.enabled===true||String(r.enabled).toLowerCase()==='true');
  images.forEach(r=>{if(!people.some(p=>p.participant_id===r.participant_id))throw Error('ไม่พบผู้เข้าร่วม active ของ '+r.image_id);if(!/^[A-Za-z0-9_-]+$/.test(r.image_id)||ids.has(r.image_id))throw Error('รหัสภาพไม่ถูกต้อง/ซ้ำ '+r.image_id);ids.add(r.image_id);if(!['FGAN','Barbershop'].includes(r.model)||!['V1','V2','V3','V4'].includes(r.tuning_variant))throw Error('โมเดล/การจูนไม่ถูกต้อง '+r.image_id);if(!r.pair_id)throw Error('ต้องใส่ pair_id '+r.image_id);['original','hair','color','result'].forEach(k=>driveImage_(r[k+'_file_id']));if(r.generation_seconds!==''&&(!Number.isFinite(Number(r.generation_seconds))||Number(r.generation_seconds)<0))throw Error('เวลาไม่ถูกต้อง '+r.image_id);const pair=r.participant_id+'|'+r.pair_id;(pairs[pair]||(pairs[pair]=[])).push(r);});
  Object.keys(pairs).forEach(k=>{const pair=pairs[k];if(pair.length!==2||pair[0].model===pair[1].model)throw Error('หนึ่งคู่ต้องมี FGAN กับ Barbershop อย่างละภาพ: '+k);['original_file_id','hair_file_id','color_file_id'].forEach(f=>{if(pair[0][f]!==pair[1][f])throw Error('Reference ของคู่ไม่ตรง: '+k)});});
  const warnings=people.filter(p=>images.filter(r=>r.participant_id===p.participant_id).length!==20).map(p=>p.participant_id);db_().toast('ตรวจผ่าน '+images.length+' ภาพ'+(warnings.length?' · ยังไม่ครบ 20 ภาพ: '+warnings.join(', '):''),'FORME',10);
}

// Administration API: only authenticated admins may use these endpoints.
function adminGetManagement(token){session_(token,'admin');const images=rows_('FS_Images'),counts={};rows_('FS_Responses').forEach(a=>{const key=a.participant_id+'|'+a.image_id;counts[key]=(counts[key]||0)+1;});return {participants:rows_('FS_Participants').map(p=>({participant_id:String(p.participant_id),status:p.status})),images:images.map(r=>{const out={};FS_SCHEMA.FS_Images.forEach(k=>out[k]=r[k]);out.fingerprint=imageFingerprint_(r);out.answer_count=counts[r.participant_id+'|'+r.image_id]||0;return out;})};}
function imageFingerprint_(r){return hash_(JSON.stringify(FS_SCHEMA.FS_Images.map(k=>r[k])));}
function enabled_(r){return r.enabled===true||String(r.enabled).toLowerCase()==='true';}
function adminResetCode(token,participantId,newCode){session_(token,'admin');if(typeof newCode!=='string'||!/^\d{6}$/.test(newCode))throw Error('รหัสผู้ใช้ต้องเป็นตัวเลข 6 หลัก');const lock=LockService.getScriptLock();lock.waitLock(15000);try{session_(token,'admin');const people=rows_('FS_Participants'),p=people.find(p=>p.participant_id===participantId),h=hash_(newCode);if(!p)throw Error('ไม่พบผู้เข้าร่วม');if(people.some(p=>p.participant_id!==participantId&&p.login_hash===h)||h===props_().getProperty('ADMIN_LOGIN_HASH'))throw Error('รหัสนี้มีผู้ใช้แล้ว');db_().getSheetByName('FS_Participants').getRange(p._row,2).setValues([[h]]);const sh=db_().getSheetByName('FS_Codes'),c=rows_('FS_Codes').find(c=>c.participant_id===participantId);sh.getRange(c?c._row:sh.getLastRow()+1,1,1,2).setValues([[participantId,newCode]]);SpreadsheetApp.flush();return {ok:true,login_code:newCode};}finally{lock.releaseLock();}}
function adminSetParticipantStatus(token,participantId,status){session_(token,'admin');if(!['active','disabled'].includes(status))throw Error('สถานะไม่ถูกต้อง');const lock=LockService.getScriptLock();lock.waitLock(15000);try{session_(token,'admin');const p=rows_('FS_Participants').find(p=>p.participant_id===participantId);if(!p)throw Error('ไม่พบผู้เข้าร่วม');db_().getSheetByName('FS_Participants').getRange(p._row,3).setValues([[status]]);return {ok:true};}finally{lock.releaseLock();}}
function adminUploadImage(token,payload){session_(token,'admin');if(!payload||!['image/jpeg','image/png','image/webp'].includes(payload.mime)||typeof payload.base64!=='string'||payload.base64.length>2800000||!/^[A-Za-z0-9+/]+={0,2}$/.test(payload.base64))throw Error('ใช้ JPG/PNG/WebP ไม่เกิน 2 MB');const bytes=Utilities.base64Decode(payload.base64),b=bytes.map(v=>v&255);if(bytes.length<12||bytes.length>2097152)throw Error('ไฟล์ใหญ่เกินไปหรือไม่ใช่ภาพ');const png=[137,80,78,71,13,10,26,10].every((v,i)=>b[i]===v),jpeg=b[0]===255&&b[1]===216&&b[2]===255,webp=String.fromCharCode(...b.slice(0,4))==='RIFF'&&String.fromCharCode(...b.slice(8,12))==='WEBP';if(!((payload.mime==='image/png'&&png)||(payload.mime==='image/jpeg'&&jpeg)||(payload.mime==='image/webp'&&webp)))throw Error('ชนิดไฟล์ไม่ตรงกับเนื้อหาภาพ');const lock=LockService.getScriptLock();lock.waitLock(15000);let folder;try{let id=props_().getProperty('FS_DRIVE_FOLDER_ID');if(!id){id=DriveApp.createFolder('FORME Hair Study Images').getId();props_().setProperty('FS_DRIVE_FOLDER_ID',id);}folder=DriveApp.getFolderById(id);}finally{lock.releaseLock();}const ext={'image/png':'png','image/jpeg':'jpg','image/webp':'webp'}[payload.mime],file=folder.createFile(Utilities.newBlob(bytes,payload.mime,'forme-'+Utilities.getUuid()+'.'+ext));return {file_id:file.getId()};}
function adminReadImage(token,imageId,kind){session_(token,'admin');if(!['original','hair','color','result'].includes(kind))throw Error('ประเภทภาพไม่ถูกต้อง');const r=rows_('FS_Images').find(r=>r.image_id===imageId);if(!r)throw Error('ไม่พบภาพ');return {data:driveImage_(r[kind+'_file_id'])};}
function adminSavePair(token,payload){session_(token,'admin');if(!payload||typeof payload!=='object'||!/^[A-Za-z0-9_-]{1,60}$/.test(payload.participant_id||'')||!/^[A-Za-z0-9_-]{1,60}$/.test(payload.pair_id||'')||typeof payload.enabled!=='boolean')throw Error('ข้อมูลชุดภาพไม่ถูกต้อง');if(!rows_('FS_Participants').some(p=>p.participant_id===payload.participant_id))throw Error('ไม่พบผู้เข้าร่วม');if(!Array.isArray(payload.records)||payload.records.length!==2||new Set(payload.records.map(r=>r.model)).size!==2)throw Error('ต้องมีผลลัพธ์ FGAN และ Barbershop อย่างละภาพ');payload.records.forEach(r=>{if(!['FGAN','Barbershop'].includes(r.model)||!['V1','V2','V3','V4'].includes(r.tuning_variant))throw Error('โมเดลหรือการจูนไม่ถูกต้อง');if(r.generation_seconds!==''&&(!Number.isFinite(r.generation_seconds)||r.generation_seconds<0))throw Error('เวลารันจริงต้องเป็นวินาทีที่ไม่ติดลบ หรือเว้นว่าง');});['original_file_id','hair_file_id','color_file_id'].forEach(k=>driveImage_(payload[k]));payload.records.forEach(r=>driveImage_(r.result_file_id));
  const lock=LockService.getScriptLock();lock.waitLock(15000);try{session_(token,'admin');const all=rows_('FS_Images'),current=payload.records.map(r=>r.image_id?all.find(a=>a.image_id===r.image_id):null);payload.records.forEach((r,i)=>{const old=current[i];if(r.image_id&&(!old||old.participant_id!==payload.participant_id||old.pair_id!==payload.pair_id||old.model!==r.model))throw Error('ชุดภาพเปลี่ยนแล้ว กรุณาโหลดข้อมูลใหม่');if(old&&imageFingerprint_(old)!==r.fingerprint)throw Error('แอดมินอีกหน้าต่างแก้ชุดนี้แล้ว กรุณาโหลดใหม่');});
    const others=all.filter(r=>r.participant_id===payload.participant_id&&r.pair_id===payload.pair_id&&enabled_(r)&&!current.some(c=>c&&c.image_id===r.image_id));if(others.length)throw Error('pair_id นี้มีชุดที่เปิดใช้อยู่แล้ว ให้เลือกแก้จากรายการ');
    const candidates=payload.records.map((r,i)=>({image_id:current[i]?current[i].image_id:'IMG_'+Utilities.getUuid().replace(/-/g,''),participant_id:payload.participant_id,pair_id:payload.pair_id,model:r.model,tuning_variant:r.tuning_variant,original_file_id:payload.original_file_id,hair_file_id:payload.hair_file_id,color_file_id:payload.color_file_id,result_file_id:r.result_file_id,generation_seconds:r.generation_seconds,enabled:payload.enabled}));
    const materialChange=current.some((old,i)=>old&&FS_SCHEMA.FS_Images.filter(k=>!['image_id','enabled'].includes(k)).some(k=>String(old[k])!==String(candidates[i][k]))),revision=materialChange,sh=db_().getSheetByName('FS_Images');
