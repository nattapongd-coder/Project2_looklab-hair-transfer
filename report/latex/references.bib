@inbook{doi:https://doi.org/10.1002/9781118653128.ch10,
author = {Fairchild, Mark D.},
publisher = {John Wiley \& Sons, Ltd},
isbn = {9781118653128},
title = {Color Appearance Models},
booktitle = {Color Appearance Models},
chapter = {10},
pages = {199--212},
doi = {https://doi.org/10.1002/9781118653128.ch10},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781118653128.ch10},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781118653128.ch10},
year = {2013},
keywords = {chromatic adaptation transforms, CIELAB, CIELUV, color appearance model},
abstract = {Summary The chromatic adaptation transforms go a long way toward extending tristimulus colorimetry toward the prediction of color appearance. A chromatic adaptation transform alone cannot be used to describe the actual color appearance of stimuli. To do this, one must use the appearance parameters, the absolute color appearance attributes of brightness, colorfulness, and hue and the relative color appearance attributes of lightness, chroma, saturation, and, again, hue. These terms are used to describe the color appearance of stimuli. Some fairly simple uniform color spaces, such as the CIE 1976 L*a*b* color space (CIELAB) and the CIE 1976 L*u*v* color space (CIELUV), can be considered color appearance models. These color spaces include simple chromatic adaptation transforms and predictors of lightness, chroma, and hue. This chapter presents the general construction of a color appearance model, and a discussion of CIELAB as a specific example. Controlled Vocabulary Terms colorimetry}
}

